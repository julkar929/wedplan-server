# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Public URL of the Next.js client (also used for CORS, OAuth redirects and Stripe return URLs)
CLIENT_URL=http://localhost:3000
# Public URL of this API server (used for upload URLs in development)
SERVER_URL=http://localhost:5000

# ---------- MongoDB ----------
MONGODB_URI=mongodb://127.0.0.1:27017/wedplan

# ---------- Better Auth ----------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Must equal CLIENT_URL: the browser talks to /api/auth/* through the client's rewrite proxy
BETTER_AUTH_URL=http://localhost:3000

# ---------- Google OAuth (https://console.cloud.google.com) ----------
# Authorized redirect URI: {CLIENT_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Stripe (Test Mode) ----------
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint {SERVER_URL}/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Optional: an existing recurring Price id. If empty a $PREMIUM_PRICE_USD/month price is created inline.
STRIPE_PREMIUM_PRICE_ID=
PREMIUM_PRICE_USD=29

# ---------- ImgBB ----------
IMGBB_API_KEY=

# ---------- Seeded admin (created at startup if missing) ----------
ADMIN_EMAIL=admin@wedplan.com
ADMIN_PASSWORD=
ADMIN_NAME=WedPlan Admin
