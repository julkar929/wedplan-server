{
  "name": "wedplan-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "test": "bash scripts/run-tests.sh",
    "test:run": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.27",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "mongodb": "^7.9.1",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "WedPlan API - Express, MongoDB, Better Auth (JWT), Stripe subscriptions, ImgBB uploads"
}